{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Buddy",
  "version": "0.1.0",
  "identifier": "dev.aibuddy.app",
  "build": {
    "frontendDist": "../../web/build"
  },
  "bundle": {
    "icon": ["icons/icon.png"]
  },
  "app": {
    "windows": [
      {
        "title": "AI Buddy",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["dev.aibuddy.app"],
          "appLink": false
        }
      ]
    }
  }
}
